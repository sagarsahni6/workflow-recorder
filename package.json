{
  "name": "workflow-recorder",
  "version": "1.0.0",
  "description": "Advanced Chrome Workflow Recorder & Automation Exporter Extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run build:pages && npm run build:scripts && npm run build:manifest",
    "build:pages": "vite build",
    "build:scripts": "node scripts/build-scripts.mjs",
    "build:manifest": "node scripts/copy-manifest.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:assets": "node scripts/generate-store-assets.mjs",
    "validate:cws": "node scripts/validate-cws.mjs",
    "package": "npm run build && node scripts/validate-cws.mjs && node scripts/package-extension.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "serve:website": "npx -y serve website -p 3000"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.7.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
